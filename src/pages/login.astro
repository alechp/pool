---
import '../styles/global.css';
import LoginForm from '../components/LoginForm.tsx';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sign In — SwimSentry</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body class="min-h-screen bg-bg-deep flex items-center justify-center px-4">
  <div class="w-full max-w-sm">
    <!-- Branding -->
    <div class="text-center mb-8">
      <div class="inline-flex items-center gap-2 mb-3">
        <div class="w-8 h-8 rounded-lg bg-accent/15 flex items-center justify-center">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-accent">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          </svg>
        </div>
        <span class="font-display text-xl font-semibold text-text-primary tracking-tight">SwimSentry</span>
      </div>
      <p class="font-mono text-[10px] uppercase tracking-[0.12em] text-text-tertiary">Pool Security Configurator</p>
    </div>

    <!-- Login Card -->
    <div class="rounded-2xl border border-border bg-bg-surface p-6">
      <h1 class="font-display text-lg font-semibold text-text-primary mb-1">Sign in</h1>
      <p class="text-sm text-text-secondary mb-6">Enter your credentials to continue.</p>

      <LoginForm client:load />
    </div>

    <!-- Register Link -->
    <p class="text-center text-sm text-text-secondary mt-6">
      First time?
      <a href="/register" class="text-accent hover:text-accent-dim transition-colors">Create an account</a>
    </p>
  </div>
</body>
</html>
