---
import Base from '../layouts/Base.astro';
import BomWorkspace from '../components/BomWorkspace.tsx';
import SectionSubnav from '../components/SectionSubnav.astro';
import { db } from '../lib/db';
import { hubTypes, hubTiers, hubTierParts, sensorTiers, sensorTierParts, savedConfigs, bomSelections } from '../lib/schema';
import { loadCatalog } from '../lib/data';
import { eq } from 'drizzle-orm';

const raw = {
  hubTypes: db.select().from(hubTypes).all(),
  hubTiers: db.select().from(hubTiers).all(),
  sensorTiers: db.select().from(sensorTiers).all(),
  hubParts: db.select().from(hubTierParts).all(),
  sensorParts: db.select().from(sensorTierParts).all(),
};
const catalog = loadCatalog(raw);

const hubTypeParam = Astro.url.searchParams.get('hub_type');
const hubTierParam = Astro.url.searchParams.get('hub_tier');
const sensorTierParam = Astro.url.searchParams.get('sensor_tier');
const qtyParam = Number.parseInt(Astro.url.searchParams.get('qty') ?? '4', 10);
const qty = Number.isFinite(qtyParam) && qtyParam > 0 ? qtyParam : 4;

const hubType = catalog.hubTypes.find((item) => item.id === hubTypeParam) ?? null;
const hubTier = catalog.hubTiers.find((item) => item.id === hubTierParam) ?? null;
const sensorTier = catalog.sensorTiers.find((item) => item.id === sensorTierParam) ?? null;
const hubParts = hubTier ? catalog.hubParts[hubTier.id] ?? [] : [];
const sensorParts = sensorTier ? catalog.sensorParts[sensorTier.id] ?? [] : [];
const buildKey = [hubType?.id ?? 'none', hubTier?.id ?? 'none', sensorTier?.id ?? 'none', qty].join(':');
const savedConfigsRows = db.select().from(savedConfigs).all()
  .map((row) => {
    const ht = catalog.hubTypes.find((item) => item.id === row.hubTypeId) ?? null;
    const hub = row.hubTierId ? catalog.hubTiers.find((item) => item.id === row.hubTierId) ?? null : null;
    const sensor = catalog.sensorTiers.find((item) => item.id === row.sensorTierId) ?? null;
    return {
      id: row.id,
      name: row.name,
      qty: row.qty,
      hubTypeId: row.hubTypeId,
      hubTierId: row.hubTierId,
      sensorTierId: row.sensorTierId,
      hubTypeName: ht?.name ?? row.hubTypeId,
      hubTierName: hub?.name ?? null,
      sensorTierName: sensor?.name ?? row.sensorTierId,
    };
  })
  .sort((a, b) => b.id - a.id);
const persistedSelections = sensorTier
  ? db.select().from(bomSelections).where(eq(bomSelections.buildKey, buildKey)).all()
  : [];
const initialState = {
  filterMode: persistedSelections[0]?.filterMode ?? null,
  selections: Object.fromEntries(persistedSelections.map((row) => [row.partName, row.selectedUrl])),
  selectionSource: Object.fromEntries(persistedSelections.map((row) => [row.partName, row.selectionSource])),
};
const subnavItems = [
  { href: '/bom', label: 'Workspace' },
  { href: '/bom/compare', label: 'Compare' },
];
---
<Base title="SwimSentry — BOM Workspace">
  <main class="max-w-[1240px] mx-auto px-4 sm:px-6 md:px-8">
    <section class="pt-2">
      <SectionSubnav items={subnavItems} />
    </section>
    <section class="py-12 text-center">
      <h1 class="text-4xl md:text-5xl font-bold tracking-tight leading-tight mb-4">
        Bill of <span class="text-accent">materials</span>
      </h1>
      <p class="text-base text-text-secondary max-w-[640px] mx-auto leading-relaxed">
        Select the supplier links you actually want for every part, compare price vs quality across the full build, and keep your chosen BOM saved locally.
      </p>
    </section>

    <section class="mb-8 rounded-2xl border border-border bg-bg-surface p-6">
      <div class="flex items-center justify-between gap-4 mb-5">
        <div>
          <div class="font-mono text-[11px] uppercase tracking-[0.12em] text-accent">Select a build</div>
          <h2 class="mt-2 text-xl font-semibold">Existing saved builds</h2>
        </div>
        <a href="/build" class="rounded-full bg-white/6 px-4 py-2 text-sm font-medium text-text-primary">
          Create another build
        </a>
      </div>
      {savedConfigsRows.length > 0 ? (
        <div class="grid md:grid-cols-2 gap-4">
          {savedConfigsRows.map((config) => (
            <div
              class={`rounded-2xl border p-4 transition-colors ${
                config.hubTierId === hubTierParam && config.sensorTierId === sensorTierParam && config.qty === qty
                  ? 'border-accent/35 bg-accent/8'
                  : 'border-white/6 bg-black/10 hover:border-white/12'
              }`}
            >
              <div class="font-mono text-[10px] uppercase tracking-[0.12em] text-text-tertiary">Saved build #{config.id}</div>
              <div class="mt-2 text-base font-semibold text-text-primary">{config.name}</div>
              <div class="mt-2 text-sm text-text-secondary">
                {config.hubTierName ? `${config.hubTierName} + ` : ''}{config.sensorTierName}
              </div>
              <div class="mt-1 text-xs text-text-tertiary">
                {config.hubTypeName} · qty {config.qty}
              </div>
              <div class="mt-4 flex items-center gap-3">
                <a href={`/bom?hub_type=${config.hubTypeId}&hub_tier=${config.hubTierId ?? ''}&sensor_tier=${config.sensorTierId}&qty=${config.qty}`} class="text-sm text-accent hover:underline">
                  Open BOM
                </a>
                <a href={`/build?config_id=${config.id}`} class="text-sm text-accent hover:underline">
                  Edit
                </a>
                <a href={`/build?fork_from=${config.id}`} class="text-sm text-accent-blue hover:underline">
                  Fork
                </a>
              </div>
            </div>
          ))}
        </div>
      ) : (
        <div class="text-sm text-text-secondary">No saved builds yet. Save a configuration from the build page first.</div>
      )}
    </section>

    {sensorTier ? (
      <BomWorkspace
        client:load
        buildKey={buildKey}
        title={`${hubTier ? `${hubTier.name} + ` : ''}${sensorTier.name}`}
        hubTypeId={hubType?.id ?? 'none'}
        hubTierId={hubTier?.id ?? null}
        sensorTierId={sensorTier.id}
        hubName={hubTier?.name ?? null}
        sensorName={sensorTier.name}
        quantity={qty}
        hubParts={hubParts}
        sensorParts={sensorParts}
        initialState={initialState}
      />
    ) : (
      <section class="rounded-2xl border border-border bg-bg-surface p-8 text-center">
        <h2 class="text-xl font-semibold">Select a build first</h2>
        <p class="mt-2 text-sm text-text-secondary">
          Open a saved configuration from the build page to populate the BOM workspace.
        </p>
        <a href="/build" class="mt-5 inline-flex rounded-full bg-accent px-4 py-2 text-sm font-semibold text-bg-deep">
          Go to build
        </a>
      </section>
    )}
  </main>
</Base>
