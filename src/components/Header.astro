<header class="py-6 border-b border-border sticky top-0 z-50 bg-bg-deep/85 backdrop-blur-xl">
  <div class="max-w-[1120px] mx-auto px-4 sm:px-6 md:px-8 flex items-center justify-between">
    <div class="flex items-center gap-2.5 min-w-0">
      <div class="w-8 h-8 bg-accent rounded-sm flex items-center justify-center flex-shrink-0">
        <svg viewBox="0 0 24 24" fill="none" stroke="#0a0b0f" stroke-width="2.5" stroke-linecap="round" class="w-[18px] h-[18px]">
          <circle cx="12" cy="12" r="3"/>
          <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/>
        </svg>
      </div>
      <div class="text-[15px] font-semibold tracking-tight whitespace-nowrap">SwimSentry <span class="text-text-tertiary font-normal">/ configurator</span></div>
    </div>
    <div class="flex items-center gap-4 flex-shrink-0">
      <div class="font-mono text-xs text-text-tertiary hidden sm:block">
        <span class="inline-block w-1.5 h-1.5 bg-accent rounded-full mr-1.5 animate-[pulse-dot_2s_ease_infinite]"></span>
        Prices live — Apr 2026
      </div>
      {Astro.locals.user && (
        <form method="POST" action="/api/auth/sign-out">
          <button type="submit" class="rounded-lg bg-white/6 px-3 py-1.5 text-[11px] font-medium text-text-secondary transition-colors hover:text-text-primary hover:bg-white/10 cursor-pointer">
            Sign out
          </button>
        </form>
      )}
    </div>
  </div>
</header>
